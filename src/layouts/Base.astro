---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/inter';
// Preload the main text font for this language so headings render without waiting (LCP).
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import serifCyrillic from '@fontsource-variable/source-serif-4/files/source-serif-4-cyrillic-opsz-normal.woff2?url';
import '../styles/palettes.css';
import '../styles/global.css';
import '../styles/ink.css';
import '../styles/components.css';
import Icon from '../components/Icon.astro';
import PalettePicker from '../components/PalettePicker.astro';
import Search from '../components/Search.astro';
import { site, footerText } from '../site.config';
import { features } from '../config/features';
import { getBook, getChapters } from '../lib/book';
import bookSettings from '../../content-meta/book-settings.json';
import mapData from '../data/map.json';
import { t, langFromPath, localize, stripLang, htmlLang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  part?: number | null;
  hasSidebar?: boolean;
  /** Open Graph type: 'article' for reading pages, 'website' otherwise. */
  ogType?: 'website' | 'article';
  /** Keep this page out of search engines (e.g. /random/). */
  noindex?: boolean;
  /** Previous / next page in book order (reading pages), for direction-aware page transitions. */
  prev?: string;
  next?: string;
  /** Link-preview image path under public/ (defaults to the chapter's or the homepage's). */
  ogImagePath?: string;
}
const { title, description = site.description, part = null, hasSidebar = false, ogType = 'website', noindex = false,
  prev, next, ogImagePath } = Astro.props;
const path = Astro.url.pathname;
const lang = langFromPath(path);
const other = lang === 'en' ? 'bg' : 'en';
const book = getBook(lang);
const bookTitle = book.title;
const L = (p: string) => localize(p, lang);
const switchHref = localize(stripLang(path), other);
const fullTitle = title ? `${title} · ${bookTitle}` : `${bookTitle} — ${book.subtitle}`;
const canonical = new URL(path, Astro.site);
const altEn = new URL(localize(stripLang(path), 'en'), Astro.site);
const altBg = new URL(localize(stripLang(path), 'bg'), Astro.site);
// Link-preview image: the chapter's card for chapter pages, the homepage card otherwise (public/og/).
const chapterLabel = stripLang(path).match(/^\/(\d{3})-/)?.[1];
const ogImage = new URL(ogImagePath ?? `/og/${chapterLabel ?? 'home'}-${lang}.jpg`, Astro.site);
const ogLocale = { en: 'en_US', bg: 'bg_BG' } as const;
// What the badge rules need to know about the book (src/lib/badges.ts), ~2 KB.
const regions = (bookSettings as { regions?: Record<string, string> }).regions ?? {};
// Also each chapter's title in this language and its emblem, for the celebrations (Motion & Story, M2).
const emblemOf = Object.fromEntries((mapData as { towns: { label: string; emblem: string }[] }).towns.map((x) => [x.label, x.emblem]));
const localTitles = Object.fromEntries((await getChapters(lang)).map((c) => [c.data.label, c.data.title]));
const bookMeta = features.games ? JSON.stringify({ chapters: (await getChapters('en')).map((c) => ({ path: `/${c.data.slug}/`,
  label: c.data.label, part: c.data.part, total: c.data.sectionCount, region: regions[c.data.label] ?? null,
  t: localTitles[c.data.label] ?? c.data.title, e: emblemOf[c.data.label] ?? 'banner' })),
  parts: getBook(lang).parts.map((p) => ({ n: p.number, roman: p.roman, t: p.title })) }) : '';
const badgeNames = features.games ? JSON.stringify({ toast: t(lang, 'badge.toast'), journey: localize('/journey/', lang),
  cel: { chapter: t(lang, 'cel.chapter'), part: t(lang, 'cel.part'), journey: t(lang, 'cel.journey'), close: t(lang, 'cel.close'), next: t(lang, 'cel.next') },
  names: Object.fromEntries(['first-page', 'chapter-complete', 'part-1', 'part-2', 'part-3', 'part-4', 'world-reader', 'cards-100', 'cards-1000',
    'mastered-50', 'streak-7', 'streak-30', 'time-keeper', 'fallacy-detective'].map((id) => [id, t(lang, `badge.${id}` as any)])) }) : '';
---
<!doctype html>
<html lang={htmlLang[lang]} data-palette={site.palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="bg" href={altBg} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={bookTitle} />
    <meta property="og:title" content={title ?? bookTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={t(lang, 'updates.feedTitle', { title: bookTitle })} href={L('/rss.xml')} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12161b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {features.offline && <link rel="manifest" href={lang === 'bg' ? '/bg/manifest.webmanifest' : '/manifest.webmanifest'} />}
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href={lang === 'bg' ? serifCyrillic : serifLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ allowPalette: site.paletteSwitcher }}>
      // Apply saved settings before the first paint (no light/dark flash). The full
      // reader-state module (src/lib/reader-state.ts) owns this data; this only reads it.
      try {
        const d = document.documentElement;
        let s = {};
        try { s = JSON.parse(localStorage.getItem('kk-settings') || 'null') || {}; } catch (e) {}
        const t = s.theme || localStorage.getItem('kk-theme');
        if (t === 'light' || t === 'dark') d.dataset.theme = t;
        const q = allowPalette && new URLSearchParams(location.search).get('palette');
        if (q && /^[a-z]{1,20}$/.test(q)) { s.palette = q; localStorage.setItem('kk-settings', JSON.stringify(s)); }
        const p = allowPalette && (s.palette || localStorage.getItem('kk-palette'));
        if (p && /^[a-z]+$/.test(p)) d.dataset.palette = p;
        if (s.motion === 'reduce') d.dataset.motion = 'reduce';
      } catch (e) {}
    </script>
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}
    {features.pageTransitions && (
      // The opt-in must be in the page itself: from the cache (and so for every reader the offline
      // service worker serves) a page can be shown before the stylesheet is applied, and the browser
      // then skips the transition. The animations themselves stay in global.css.
      <style is:inline>@view-transition{navigation:auto}</style>
    )}
    {features.pageTransitions && (
      <script is:inline>
        // Page transitions follow the book: arriving from the previous page slides forward,
        // from the next page slides back (CSS in global.css). Must run before first render.
        addEventListener('pagereveal', (e) => {
          try {
            const from = e.viewTransition && window.navigation && navigation.activation && navigation.activation.from;
            if (!from || !from.url) return;
            const p = new URL(from.url).pathname;
            const rel = (r) => document.querySelector('link[rel="' + r + '"]')?.getAttribute('href');
            if (p === rel('prev')) e.viewTransition.types.add('forward');
            else if (p === rel('next')) e.viewTransition.types.add('backward');
            // Arriving from a town on the Kingdom Map: dive into it (Motion & Story, M2).
            const dive = JSON.parse(sessionStorage.getItem('kk-dive') || 'null');
            sessionStorage.removeItem('kk-dive');
            if (dive && Date.now() - dive.at < 8000) {
              e.viewTransition.types.add('dive');
              document.documentElement.classList.add('kk-dived');
              document.documentElement.style.setProperty('--dive-x', dive.x + 'px');
              document.documentElement.style.setProperty('--dive-y', dive.y + 'px');
            }
          } catch (err) {}
        });
      </script>
    )}
    {site.goatcounter && import.meta.env.PROD && (
      <script is:inline async data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} src="/vendor/goatcounter-count.js"></script>
    )}
  </head>
  <body data-part={part ?? undefined} data-pv={features.previews ? JSON.stringify({
    term: t(lang, 'pv.term'), readMore: t(lang, 'pv.readMore'), source: t(lang, 'pv.source'),
    copyPara: t(lang, 'pv.copyPara'), copyHeading: t(lang, 'pv.copyHeading'), copied: t(lang, 'pv.copied'),
  }) : undefined}>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <header class="site-header">
      <div class="inner">
        {hasSidebar && (
          <button class="icon-btn nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" data-nav-toggle>
            <Icon name="menu" /><span class="visually-hidden">{t(lang, 'nav.openContents')}</span>
          </button>
        )}
        <a class="brand" href={L('/')}><span>{bookTitle}</span></a>
        <nav class="header-nav" aria-label={t(lang, 'nav.site')}>
          <a class="hide-sm" href={L('/about/')} aria-current={stripLang(path) === '/about/' ? 'page' : undefined}>{t(lang, 'nav.about')}</a>
          <a class="hide-sm" href={L('/roadmap/')} aria-current={stripLang(path) === '/roadmap/' ? 'page' : undefined}>{t(lang, 'nav.roadmap')}</a>
          <a class="hide-sm" href={L('/timeline/')} aria-current={stripLang(path) === '/timeline/' ? 'page' : undefined}>{t(lang, 'nav.timeline')}</a>
          {features.atlas && <a class="hide-sm hide-md" href={L('/atlas/')} aria-current={stripLang(path) === '/atlas/' ? 'page' : undefined}>{t(lang, 'nav.atlas')}</a>}
          {features.games
            ? <a class="hide-sm" href={L('/play/')} aria-current={stripLang(path).startsWith('/play/') ? 'page' : undefined}>{t(lang, 'nav.play')}</a>
            : <a class="hide-sm hide-md" href={L('/random/')}>{t(lang, 'nav.random')}</a>}
          <Search />
          {site.paletteSwitcher && <PalettePicker />}
          <button class="icon-btn" type="button" data-theme-toggle aria-label={t(lang, 'nav.toggleTheme')}>
            <Icon name="moon" class="theme-icon-moon" /><Icon name="sun" class="theme-icon-sun" />
          </button>
          <a class="icon-btn lang-switch" href={switchHref} hreflang={other} lang={other} data-lang-switch
             aria-label={`${t(lang, 'nav.switchLangShort')}: ${t(lang, 'nav.switchLang')}`} title={t(lang, 'nav.switchLang')}>
            <Icon name="globe" /><span>{t(lang, 'nav.switchLangShort')}</span>
          </a>
        </nav>
      </div>
    </header>
    <slot />
    {bookMeta && <script type="application/json" id="kk-book" data-strings={badgeNames} set:html={bookMeta} />}
    <footer class="site-footer">
      <div class="inner">
        <p style="margin:0">{footerText()}{lang === 'bg' && (
          <><br /><small>{t(lang, 'mt.credit')} <a href="https://github.com/Helsinki-NLP/OPUS-MT" lang="en">OPUS-MT</a> (CC BY 4.0)</small></>
        )}</p>
        <nav aria-label={t(lang, 'nav.footer')}>
          <a href={L('/about/')}>{t(lang, 'nav.about')}</a>
          <a href={L('/roadmap/')}>{t(lang, 'nav.roadmap')}</a>
          <a href={L('/updates/')}>{t(lang, 'nav.updates')}</a>
          <a href={L('/timeline/')}>{t(lang, 'nav.timeline')}</a>
          {features.atlas && <a href={L('/atlas/')}>{t(lang, 'nav.atlas')}</a>}
          <a href={L('/random/')}>{t(lang, 'nav.random')}</a>
          <a href={L('/bookmarks/')}>{t(lang, 'bookmarks.title')}</a>
          {features.games && <a href={L('/play/')}>{t(lang, 'play.nav')}</a>}
          {site.supportUrl && <a href={site.supportUrl} rel="noopener">☕ {t(lang, 'support.link')}</a>}
          <a href={switchHref} hreflang={other} lang={other}>{other === 'bg' ? 'Български' : 'English'}</a>
          <span>{book.edition ? `${t(lang, 'edition', { n: book.edition })} · ${book.editionDate}` : ''}</span>
        </nav>
      </div>
    </footer>
    <style is:global>
      .theme-icon-sun { display: none; }
      :root[data-theme='dark'] .theme-icon-sun { display: block; }
      :root[data-theme='dark'] .theme-icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme-icon-sun { display: block; }
        :root:not([data-theme='light']) .theme-icon-moon { display: none; }
      }
    </style>
    <script>
      import '../scripts/progress.ts';
      import { features } from '../config/features';
      if (features.previews) { import('../scripts/previews.ts'); import('../scripts/anchors.ts'); }
      if (features.listen && document.querySelector('[data-listen]')) import('../scripts/listen-button.ts');
      if (features.offline && import.meta.env.PROD) import('../scripts/offline.ts');
      if (features.games && document.getElementById('kk-book')) import('../scripts/badges.ts');
      if (features.celebrations && document.getElementById('kk-book')) import('../scripts/celebrate.ts');
      if (features.explorables && document.querySelector('script[data-explorables]')) import('../scripts/explorables.ts');
    </script>
    <script>
      import { store } from '../scripts/reader';
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        const apply = () => { root.dataset.theme = next; };
        const vt = (document as any).startViewTransition;
        if (vt && !matchMedia('(prefers-reduced-motion: reduce)').matches) vt.call(document, apply); else apply();
        store.setSettings({ theme: next });
      });

      // Mobile contents drawer
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const sidebar = document.getElementById('sidebar');

      // Keep the current chapter in view inside the (independently scrolling) sidebar.
      const inner = sidebar?.querySelector<HTMLElement>('.sidebar-inner');
      const here = sidebar?.querySelector<HTMLElement>('.sb-sections [aria-current="page"], .sb-chapter.is-current');
      if (inner && here) {
        const top = here.getBoundingClientRect().top - inner.getBoundingClientRect().top;
        if (top > inner.clientHeight * 0.6) inner.scrollTop = top - inner.clientHeight * 0.3;
      }
      const scrim = document.querySelector<HTMLElement>('.scrim');
      const setOpen = (open: boolean) => {
        if (!toggle || !sidebar) return;
        sidebar.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
        if (open) sidebar.querySelector<HTMLElement>('[aria-current="page"], a')?.focus();
      };
      toggle?.addEventListener('click', () => setOpen(sidebar?.dataset.open !== 'true'));
      scrim?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar?.dataset.open === 'true') { setOpen(false); toggle?.focus(); }
      });
    </script>
  </body>
</html>
