---
// /play/: the hub for review, games and the journey page (v2 Phase 2).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, langFromPath, localize } from '../i18n/ui';
const lang = langFromPath(Astro.url.pathname);
const L = (p: string) => localize(p, lang);
const items = [
  { href: L('/review/'), icon: 'flashcards', title: t(lang, 'review.title'), blurb: t(lang, 'play.reviewBlurb'), due: true },
  { href: L('/play/which-came-first/'), icon: 'repeat', title: t(lang, 'wf.title'), blurb: t(lang, 'play.wfBlurb') },
  { href: L('/play/fallacy-detective/'), icon: 'search', title: t(lang, 'fd.title'), blurb: t(lang, 'play.fdBlurb') },
  { href: L('/journey/'), icon: 'bookmark', title: t(lang, 'journey.title'), blurb: t(lang, 'play.journeyBlurb') },
];
---
<Base title={t(lang, 'play.title')} description={t(lang, 'play.lede')}>
  <main id="main" class="container learn-page" data-part="6">
    <header class="page-head">
      <h1>{t(lang, 'play.title')}</h1>
      <p class="standfirst">{t(lang, 'play.lede')}</p>
    </header>
    <div class="play-grid">
      {items.map((x) => (
        <a class="play-card" href={x.href}>
          <Icon name={x.icon} class="icon" />
          <strong>{x.title}</strong>
          <span>{x.blurb}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
