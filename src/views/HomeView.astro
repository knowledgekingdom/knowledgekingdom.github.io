---
import Base from '../layouts/Base.astro';
import ChapterCard from '../components/ChapterCard.astro';
import Icon from '../components/Icon.astro';
import { getBook, getRoadmap, getFlashcards, updates, figures, getChapters, getSections, getPage, chapterUrl, pageInfo } from '../lib/book';
import { t, langFromPath, localize } from '../i18n/ui';
import { site } from '../site.config';
import { features } from '../config/features';

const lang = langFromPath(Astro.url.pathname);
const L = (p: string) => localize(p, lang);
const book = getBook(lang);
const roadmap = getRoadmap(lang);
const chapters = await getChapters(lang);
const sections = await getSections(lang);
const about = await getPage('about', lang);
const first = chapters[0];
const sectionCount = sections.filter((s) => s.data.type === 'section' || s.data.type === 'summary').length;
const cardCount = Object.values(getFlashcards(lang).chapters).reduce((n, c) => n + c.cards.length, 0);
const written = new Set(chapters.map((c) => c.data.number));
const planned = roadmap.chapters.filter((c) => !written.has(c.number));
const nextPlanned = planned.slice(0, 3);
const words = book.titleDisplay.split(/\s+/);
// First full sentence of "A note to the reader" (never a truncated fragment).
const aboutText = about?.body?.replace(/<[^>]+>/g, '').replace(/\\(.)/g, '$1') ?? '';
const lede = aboutText.match(/^[\s\S]*?[.!?](?=\s|$)/)?.[0].trim() || site.description;
// "Recently updated": what the latest edition added or revised, in this language.
const latest = updates.editions?.find((e) => !e.baseline);
const latestLinks = latest
  ? [
      ...latest.newChapters.map((l) => ({ ...l, kind: 'new', isChapter: true })),
      ...latest.newSections.map((l) => ({ ...l, kind: 'new', isChapter: false })),
      ...latest.changed.map((l) => ({ ...l, kind: 'revised', isChapter: false })),
    ].slice(0, 8)
  : [];
const recent = (await Promise.all(latestLinks.map(async (l) => {
  const info = await pageInfo(l.url, lang);
  return info && { ...info, kind: l.kind, isChapter: l.isChapter };
}))).filter((x) => x !== undefined);
---
<Base description={lang === 'en' ? site.description : lede}>
  <main id="main">
    <section class="hero container" data-part="1">
      <p class="hero-deck">{book.subtitle}</p>
      <h1 class="hero-title">{words.map((w) => <span>{w.charAt(0) + w.slice(1).toLowerCase()}</span>)}</h1>
      <div class="hero-rule"><span>{t(lang, 'edition', { n: book.edition ?? '' })} · {book.editionDate}</span></div>
      <p class="hero-lede">{lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-continue" href={L('/')} data-continue hidden>
          <Icon name="bookmark" /> <span>{t(lang, 'progress.continue')}<span class="visually-hidden">:</span> <span class="continue-title" data-continue-title></span></span>
        </a>
        {first && <a class="btn btn-primary" href={chapterUrl(first, lang)} data-start>{t(lang, 'home.start')} <Icon name="arrowRight" class="arrow" /></a>}
        <a class="btn" href={L('/random/')}><Icon name="shuffle" /> {t(lang, 'home.random')}</a>
        <a class="btn" href={L('/about/')}><Icon name="book" /> {t(lang, 'home.about')}</a>
      </div>
    </section>

    <div class="container">
      <div class="stats" role="list" aria-label={t(lang, 'home.stats')}>
        <div role="listitem"><strong>{chapters.length}</strong><span>{t(lang, 'home.chapters')}</span></div>
        <div role="listitem"><strong>{sectionCount}</strong><span>{t(lang, 'home.sections')}</span></div>
        <div role="listitem"><strong>{figures.length}</strong><span>{t(lang, 'home.figures')}</span></div>
        <div role="listitem"><strong>{cardCount}</strong><span>{t(lang, 'home.flashcards')}</span></div>
      </div>
      <p class="home-progress" data-overall data-total={sectionCount} data-label={t(lang, 'progress.overall')} hidden>
        <span data-overall-text></span>
        <button class="link-btn" type="button" data-progress-reset data-confirm={t(lang, 'progress.resetConfirm')}>{t(lang, 'progress.reset')}</button>
      </p>

      {book.parts.map((part) => {
        const pcs = chapters.filter((c) => c.data.part === part.number);
        return (
          <section class="part-block" data-part={part.number} aria-labelledby={`part-${part.number}`}>
            <header class="part-head">
              <span class="part-numeral" aria-hidden="true" style={`view-transition-name: part-${part.number}`}>{part.roman}</span>
              <span class="kicker">{t(lang, 'part', { n: part.roman })}</span>
              <h2 id={`part-${part.number}`}><a href={L(`/${part.slug}/`)}>{part.title}</a></h2>
              <span class="meta">{t(lang, 'nChapters', { n: pcs.length })}</span>
              <span class="part-progress" data-part-progress={pcs.map((c) => `/${c.data.slug}/`).join(' ')}
                    data-total={pcs.reduce((n, c) => n + c.data.sectionCount, 0)} data-label={t(lang, 'progress.partOf')} hidden>
                <span class="bar" aria-hidden="true"><span></span></span><span class="txt"></span>
              </span>
            </header>
            <div class="card-grid">
              {pcs.map((c) => <ChapterCard chapter={c} />)}
            </div>
          </section>
        );
      })}

      {latest && recent.length > 0 && (
        <section class="home-section" aria-labelledby="recent">
          <h2 id="recent">{t(lang, 'home.recent')}</h2>
          <ul class="recent-list">
            {recent.map((r) => (
              <li>
                <a href={r.url}>{r.isChapter ? `${r.chapterLabel} · ${r.title}` : r.title}</a>
                <span class="meta">{t(lang, r.kind === 'new' ? 'updates.tagNew' : 'updates.tagRevised')} · {t(lang, 'edition', { n: latest.edition })}</span>
              </li>
            ))}
          </ul>
          <p><a class="more-link" href={L('/updates/')}>{t(lang, 'updates.all')} <Icon name="arrowRight" class="arrow" /></a></p>
        </section>
      )}

      {planned.length > 0 && (
        <section class="home-section" aria-labelledby="coming">
          <div class="roadmap-teaser">
            <div>
              <span class="kicker" style="color:var(--ink-3)">{t(lang, 'home.wip')}</span>
              <h2 id="coming" style="margin:.35rem 0 0">{t(lang, 'home.morePlanned', { n: planned.length })}</h2>
              <p>{t(lang, 'home.nextUp')} {nextPlanned.map((c, i) => <>{i > 0 && ', '}<em>{c.title}</em></>)}{planned.length > 3 && ' …'}</p>
            </div>
            <a class="btn" href={L('/roadmap/')}>{t(lang, 'home.seeRoadmap')} <Icon name="arrowRight" class="arrow" /></a>
          </div>
        </section>
      )}

      {features.games && (
        <section class="home-section" aria-labelledby="play-h">
          <h2 id="play-h">{t(lang, 'play.homeTitle')}</h2>
          <div class="play-grid">
            <a class="play-card" href={L('/review/')}><Icon name="flashcards" class="icon" /><strong>{t(lang, 'review.title')}</strong><span>{t(lang, 'play.reviewBlurb')}</span></a>
            <a class="play-card" href={L('/play/which-came-first/')}><Icon name="repeat" class="icon" /><strong>{t(lang, 'wf.title')}</strong><span>{t(lang, 'play.wfBlurb')}</span></a>
            <a class="play-card" href={L('/play/fallacy-detective/')}><Icon name="search" class="icon" /><strong>{t(lang, 'fd.title')}</strong><span>{t(lang, 'play.fdBlurb')}</span></a>
            <a class="play-card" href={L('/journey/')}><Icon name="bookmark" class="icon" /><strong>{t(lang, 'journey.title')}</strong><span>{t(lang, 'play.journeyBlurb')}</span></a>
          </div>
        </section>
      )}

      {features.progressTransfer && (
        <section class="home-section transfer" aria-labelledby="your-progress" data-transfer hidden
                 data-exported={t(lang, 'transfer.exported')} data-imported={t(lang, 'transfer.imported')}
                 data-error-format={t(lang, 'transfer.errorFormat')} data-error-newer={t(lang, 'transfer.errorNewer')}>
          <h2 id="your-progress">{t(lang, 'transfer.title')}</h2>
          <p>{t(lang, 'transfer.intro')}</p>
          <div class="transfer-actions">
            <button class="btn" type="button" data-export><Icon name="download" /> {t(lang, 'transfer.export')}</button>
            <button class="btn" type="button" data-import><Icon name="upload" /> {t(lang, 'transfer.import')}</button>
            <input type="file" accept="application/json,.json" data-import-file hidden />
          </div>
          <p><a class="more-link" href={L('/bookmarks/')}><Icon name="bookmark" /> {t(lang, 'bookmarks.link')} <Icon name="arrowRight" class="arrow" /></a></p>
          <p class="meta" role="status" data-transfer-status></p>
        </section>
      )}
    </div>
  </main>
</Base>
