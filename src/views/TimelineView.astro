---
// /timeline/: the Living Timeline (v2 Phase 4). Events come from the knowledge layer
// (content-meta/knowledge/events.yaml, approved entries only on the live site). The zoomable
// canvas (src/scripts/living-timeline.ts) and the list below show the same events; the list works
// without JavaScript and is the accessible way through.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getChapters, pageInfo } from '../lib/book';
import { getTimeline } from '../lib/timeline';
import { formatDate, position } from '../lib/time-scale';
import { knowledge, tx, citeUrl } from '../lib/knowledge';
import { t, langFromPath, localize } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const chapters = new Map((await getChapters(lang)).map((c) => [c.data.label, c]));

const REGIONS = ['africa', 'west-asia', 'mediterranean-europe', 'central-asia-steppe', 'south-asia', 'southeast-asia',
  'east-asia', 'oceania', 'americas', 'global'] as const;
const regionName = (r: string) => t(lang, `region.${r}` as any);

const events = (await Promise.all(knowledge.events.map(async (e) => {
  const approx = e.precision === 'approximate';
  return {
    id: e.id, label: tx(e.label, lang), date: formatDate({ start: e.start, end: e.end, approx }, lang),
    start: e.start, end: e.end, approx, region: e.region, chapter: e.chapter ?? '',
    part: chapters.get(e.chapter ?? '')?.data.part ?? null,
    links: await Promise.all(e.sections.map(async (s) => {
      const info = await pageInfo(s.url, lang);
      return { href: citeUrl(s, lang), title: info ? `${info.chapterLabel} · ${info.title}` : s.id, path: s.url };
    })),
  };
}))).sort((a, b) => a.start - b.start || a.end - b.end);

const regions = REGIONS.filter((r) => events.some((e) => e.region === r)).map((r) => ({ id: r, name: regionName(r) }));
const spans = Object.entries(getTimeline(lang).chapterSpans)
  .filter(([l]) => chapters.has(l))
  .map(([label, [start, end]]) => ({ label, title: chapters.get(label)!.data.title, part: chapters.get(label)!.data.part, start, end }))
  .sort((a, b) => a.start - b.start);
// The canvas height is known in advance (chapter-band rows + axis + one lane per region), so the
// page reserves it and nothing jumps when the drawing appears. Same packing as the script.
const bandRows: { a: number; b: number }[][] = [];
for (const sp of spans) {
  const a = position(sp.start), b = position(sp.end);
  let row = bandRows.findIndex((r) => r.every((x) => x.b + 0.4 < a || x.a - 0.4 > b));
  if (row === -1) row = bandRows.push([]) - 1;
  bandRows[row].push({ a, b });
}
const canvasHeight = bandRows.length * 12 + 8 + 28 + regions.length * 46 + 4;
const chapterOptions = [...new Set(events.map((e) => e.chapter))].sort().map((l) => chapters.get(l)).filter((c) => c !== undefined);
const strings = Object.fromEntries(['read', 'meanwhile', 'meanwhileAt', 'around', 'nothing', 'close', 'showing', 'cluster',
  'readCount', 'compressed', 'canvasLabel', 'inView'].map((k) => [k, t(lang, `lt.${k}` as any)]));
---
<Base title={t(lang, 'timeline.title')} description={t(lang, 'lt.lede', { n: events.length })}>
  <main id="main" class="container living-timeline" data-part="2" data-lt
        data-events={JSON.stringify(events)} data-regions={JSON.stringify(regions)} data-spans={JSON.stringify(spans)}
        data-strings={JSON.stringify(strings)} data-lang={lang}>
    <header class="page-head">
      <span class="kicker">{t(lang, 'timeline.kicker')}</span>
      <h1>{t(lang, 'timeline.title')}</h1>
      <p class="standfirst">{t(lang, 'lt.lede', { n: events.length })}</p>
    </header>

    <noscript><style>.lt-explorer, [data-in-view-wrap] { display: none !important; }</style></noscript>
    <section class="lt-explorer" data-explorer aria-label={t(lang, 'lt.explorer')}>
      <div class="lt-toolbar">
        <div class="lt-zoom" role="group" aria-label={t(lang, 'lt.zoom')}>
          <button type="button" class="icon-btn" data-zoom="in" aria-label={t(lang, 'lt.zoomIn')}>+</button>
          <button type="button" class="icon-btn" data-zoom="out" aria-label={t(lang, 'lt.zoomOut')}>−</button>
          <button type="button" class="btn btn-quiet" data-zoom="all">{t(lang, 'lt.whole')}</button>
        </div>
        <label class="lt-check"><input type="checkbox" data-reading /> {t(lang, 'lt.yourReading')}</label>
        <span class="meta" data-read-count></span>
      </div>
      <fieldset class="lt-lanes">
        <legend>{t(lang, 'lt.regions')}</legend>
        {regions.map((r) => <label><input type="checkbox" value={r.id} checked data-lane /> <span>{r.name}</span></label>)}
      </fieldset>
      <div class="lt-canvas-wrap" data-wrap style={`height:${canvasHeight}px`}>
        <canvas data-canvas tabindex="0" role="img"></canvas>
        <div class="lt-card" data-card role="dialog" aria-modal="false" hidden></div>
      </div>
      <p class="meta lt-help">{t(lang, 'lt.help')}</p>
      <section class="lt-meanwhile" data-meanwhile aria-live="polite" hidden></section>
    </section>

    <section class="lt-list-section" aria-labelledby="lt-list-h">
      <h2 id="lt-list-h">{t(lang, 'lt.listTitle')}</h2>
      <div class="lt-filters">
        <label>{t(lang, 'timeline.filter')}
          <select data-chapter>
            <option value="">{t(lang, 'timeline.all')}</option>
            {chapterOptions.map((c) => <option value={c.data.label}>{c.data.label} · {c.data.title}</option>)}
          </select>
        </label>
        <label class="lt-check" data-in-view-wrap><input type="checkbox" data-in-view /> {t(lang, 'lt.inView')}</label>
        <span class="meta" data-status role="status"></span>
      </div>
      <ol class="lt-list" data-list>
        {events.map((e) => (
          <li class="lt-item" data-id={e.id} data-region={e.region} data-chapter={e.chapter} data-start={e.start} data-end={e.end}>
            <span class="lt-date">{e.date}</span>
            <span class="lt-label">{e.label}</span>
            <span class="lt-region">{regionName(e.region)}</span>
            <span class="lt-links">{e.links.map((l) => <a href={l.href}>{l.title}</a>)}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
<script>
  import '../scripts/living-timeline.ts';
</script>
