---
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import Reading from '../layouts/Reading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MtNotice from '../components/MtNotice.astro';
import Flashcards from '../components/Flashcards.astro';
import PracticeLab from '../components/PracticeLab.astro';
import SourcesList from '../components/SourcesList.astro';
import SectionEnd from '../components/SectionEnd.astro';
import {
  partByNumber, getFlashcards, getPractice, getSources, isTranslated, hasBulgarian, pageInfo, type Section,
} from '../lib/book';
import { termsFor } from '../lib/terms';
import explorablesData from '../data/explorables.json';
import { features } from '../config/features';
import Icon from '../components/Icon.astro';
import { t, langFromPath, localize, stripLang, type UIKey } from '../i18n/ui';

const { section } = Astro.props as { section: Section };
const lang = langFromPath(Astro.url.pathname);
const L = (p: string) => localize(p, lang);
const d = section.data;
const { Content, headings: mdHeadings } = await render(section);
const part = partByNumber(d.part, lang);

const practice = d.type === 'practice' ? getPractice(lang)[d.chapterLabel as keyof ReturnType<typeof getPractice>] : undefined;
const fcAll = getFlashcards(lang);
const deck = d.type === 'flashcards' ? fcAll.chapters[d.chapterLabel as keyof typeof fcAll.chapters] : undefined;
const sources = d.type === 'sources' ? getSources(lang)[d.chapterLabel as keyof ReturnType<typeof getSources>] : undefined;

// The on-page TOC lists H3s for prose, and the exercise groups for practice labs.
const headings = practice
  ? practice.groups.filter((g) => g.title).map((g, i) => ({ depth: 2, slug: `group-${i + 1}`, text: g.title as string }))
  : mdHeadings;
const toc = headings.filter((h) => h.depth === 2);
const isSpecial = d.type === 'practice' || d.type === 'flashcards' || d.type === 'sources';
const kicker = d.type === 'section' ? t(lang, d.number != null ? 'section' : 'feature') : t(lang, `special.${d.type}` as UIKey);
const translated = lang === 'bg' && (isSpecial ? hasBulgarian : isTranslated(section));
// Key terms this section mentions (definition popovers on their first mention).
const terms = features.previews && d.type === 'section'
  ? await Promise.all(termsFor({ body: section.body ?? '', path: stripLang(Astro.url.pathname), chapter: d.chapterLabel, lang })
      .map(async (x) => ({ ...x, moreTitle: (await pageInfo(x.definedPath, lang))?.title ?? '' })))
  : [];
// This section's own link-preview card, if the build made one (scripts/og-sections.mjs).
const ogSection = `/og/s/${lang}/${d.chapterLabel}/${d.slug}.jpg`;
const ogImagePath = existsSync(`${process.cwd()}/public${ogSection}`) ? ogSection : undefined;
// Explorable diagrams for this section (content-meta/explorables.yaml).
const explorables = features.explorables
  ? (explorablesData as { id: string; url: string; anchor: string; title: Record<string, string>; instruction: Record<string, string>; notice: Record<string, string> }[])
      .filter((e) => e.url === stripLang(Astro.url.pathname))
      .map((e) => ({ id: e.id, anchor: e.anchor, title: e.title[lang], instruction: e.instruction[lang], notice: e.notice[lang] }))
  : [];
const exStrings = JSON.stringify({ kicker: t(lang, 'ex.kicker'), loading: t(lang, 'ex.loading'), reset: t(lang, 'ex.reset'), notice: t(lang, 'ex.notice') });
const termJson = JSON.stringify(terms).replace(/</g, '\\u003c');
---
<Reading title={`${d.title} · ${d.chapterLabel} ${d.chapterTitle}`} description={d.description} part={d.part}
         chapter={d.chapter} headings={headings} ogImagePath={ogImagePath}>
  <article data-pagefind-meta={`chapter:${d.chapterLabel} · ${d.chapterTitle}`}>
    <div class="column">
      <Breadcrumbs items={[
        ...(part ? [{ href: L(`/${part.slug}/`), label: t(lang, 'part', { n: part.roman }) }] : []),
        { href: L(`/${d.chapterSlug}/`), label: `${d.chapterLabel} ${d.chapterTitle}` },
        { label: d.title },
      ]} />
      <header class="section-head">
        <span class="section-number" data-pagefind-ignore>
          {kicker}{d.number != null && d.type === 'section' && <b>{d.number}</b>}
          <span class="meta-sep">·</span><a href={L(`/${d.chapterSlug}/`)} style="color:inherit;text-decoration:none">{t(lang, 'chapter', { n: d.chapterLabel })}</a>
        </span>
        <h1>{d.title}</h1>
        <div class="section-tools" data-pagefind-ignore>
          {!isSpecial && <span class="meta">{t(lang, 'minRead', { n: d.readingTime })}</span>}
          <button class="tool-btn" type="button" data-bookmark data-path={stripLang(Astro.url.pathname)}
                  data-title={`${d.chapterLabel} · ${d.title}`} data-label-add={t(lang, 'bookmark.add')}
                  data-label-on={t(lang, 'bookmark.on')} aria-pressed="false" hidden>
            <Icon name="bookmark" /><span data-bookmark-label>{t(lang, 'bookmark.add')}</span>
          </button>
          {features.listen && (d.type === 'section' || d.type === 'summary') && (
            <button class="tool-btn" type="button" data-listen hidden data-strings={JSON.stringify({
              player: t(lang, 'listen.player'), play: t(lang, 'listen.play'), pause: t(lang, 'listen.pause'),
              speed: t(lang, 'listen.speed'), voice: t(lang, 'listen.voice'), next: t(lang, 'listen.next'),
              close: t(lang, 'listen.close'), progress: t(lang, 'listen.progress'), pressPlay: t(lang, 'listen.pressPlay'),
            })}>
              <Icon name="headphones" /><span>{t(lang, 'listen.button')}</span>
            </button>
          )}
        </div>
      </header>
      <MtNotice show={translated} />
      {toc.length > 1 && (
        <details class="toc-inline">
          <summary>{t(lang, 'nav.onThisPage')}</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
    </div>

    {d.type === 'practice' && (
      <div class="column">
        {practice ? <PracticeLab groups={practice.groups} answerIntro={practice.answerIntro} /> : <div class="prose"><Content /></div>}
      </div>
    )}
    {d.type === 'flashcards' && (
      <div class="column-wide">
        {deck && deck.cards.length
          ? <Flashcards chapter={d.chapterLabel} cards={deck.cards} deckTitle={deck.deck} />
          : <p class="placeholder">{t(lang, 'fc.noDeck')}</p>}
      </div>
    )}
    {d.type === 'sources' && (
      <div class="column">
        {sources && <SourcesList intro={sources.intro} entries={sources.entries} further={sources.further} notes={sources.notes} />}
      </div>
    )}
    {!isSpecial && <div class="prose"><Content /></div>}
    {terms.length > 0 && <script type="application/json" data-terms set:html={termJson} />}
    {explorables.length > 0 && (
      <>
        <script type="application/json" data-explorables data-strings={exStrings} set:html={JSON.stringify(explorables).replace(/</g, '\\u003c')} />
        <script is:inline>
          // Place explorable placeholders now, before the page is first shown (no layout jump later).
          (function () {
            var data = document.querySelector('script[data-explorables]');
            var prose = document.querySelector('article .prose');
            if (!data || !prose) return;
            var S = JSON.parse(data.getAttribute('data-strings') || '{}');
            var paras = [].filter.call(prose.children, function (c) { return c.tagName === 'P' && (c.textContent || '').trim(); });
            JSON.parse(data.textContent || '[]').forEach(function (e) {
              var a = e.anchor, after = null;
              if (a.indexOf('figure-') === 0) { var f = document.getElementById(a); after = f && (f.closest('figure') || f); }
              else if (a.indexOf('paragraph ') === 0) after = paras[Number(a.split(' ')[1]) - 1];
              else after = prose.lastElementChild;
              if (!after) return;
              var box = document.createElement('section');
              box.className = 'explorable';
              box.setAttribute('data-ex-id', e.id);
              box.setAttribute('aria-labelledby', 'ex-' + e.id);
              box.innerHTML = '<header class="ex-head"><span class="ex-kicker"></span><h2 class="ex-title" id="ex-' + e.id + '"></h2><p class="ex-instruction"></p></header>'
                + '<div class="ex-body" data-ex-body><p class="ex-loading"></p></div>'
                + '<footer class="ex-foot"><button type="button" class="link-btn" data-ex-reset></button>'
                + '<details class="ex-notice"><summary></summary><p></p></details></footer>';
              box.querySelector('.ex-kicker').textContent = S.kicker || '';
              box.querySelector('.ex-title').textContent = e.title;
              box.querySelector('.ex-instruction').textContent = e.instruction;
              box.querySelector('.ex-loading').textContent = S.loading || '';
              box.querySelector('[data-ex-reset]').textContent = S.reset || '';
              box.querySelector('.ex-notice summary').textContent = S.notice || '';
              box.querySelector('.ex-notice p').textContent = e.notice;
              after.after(box);
            });
          })();
        </script>
      </>
    )}
    <SectionEnd trackable={d.type === 'section' || d.type === 'summary'} related={d.type === 'section'}
                title={`${d.chapterLabel} · ${d.title}`} />
  </article>
</Reading>
