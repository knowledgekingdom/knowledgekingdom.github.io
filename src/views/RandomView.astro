---
import Base from '../layouts/Base.astro';
import { t, langFromPath, localize } from '../i18n/ui';
const lang = langFromPath(Astro.url.pathname);
---
<Base title={t(lang, 'random.title')} description={t(lang, 'random.title')} noindex>
  <main id="main" class="container" style="padding:4rem var(--gutter)">
    <p class="meta" data-random-status data-prefix={lang === 'bg' ? '/bg' : ''}
       data-failed={t(lang, 'random.failed')} data-back={t(lang, 'random.back')} data-home={localize('/', lang)}>
      {t(lang, 'random.finding')}
    </p>
    <noscript><p>{t(lang, 'random.noscript')} <a href={localize('/', lang)}>{t(lang, 'random.back')}</a></p></noscript>
  </main>
  <script>
    const el = document.querySelector<HTMLElement>('[data-random-status]')!;
    fetch('/random/urls.json')
      .then((r) => r.json())
      .then((urls: string[]) => {
        location.replace(el.dataset.prefix + urls[Math.floor(Math.random() * urls.length)]);
      })
      .catch(() => {
        el.textContent = `${el.dataset.failed} `;
        const a = document.createElement('a');
        a.href = el.dataset.home!;
        a.textContent = el.dataset.back!;
        el.append(a);
      });
  </script>
</Base>
