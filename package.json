{
  "name": "knowledge-kingdom",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "import": "python importer/import_manuscript.py",
    "translate": "node scripts/translate.mjs",
    "update": "npm run import && npm run translate && npm run og && npm run backup",
    "backup": "node scripts/backup-manuscript.mjs",
    "test:importer": "python -m unittest discover -s importer/tests",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "og": "node scripts/og-images.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "lighthouse": "13.6.0",
    "pagefind": "1.6.0",
    "typescript": "5.9.3"
  }
}
